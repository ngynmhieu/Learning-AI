# Read automatically by `supabase start` to resolve env(...) substitutions
# in supabase/config.toml. Copy to .env and fill in from the OAuth client
# already used for the cloud project's Google login (Google Cloud Console
# -> APIs & Services -> Credentials). That same client also needs
# http://127.0.0.1:54321/auth/v1/callback added as an Authorized redirect URI.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=paste-client-id-here
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=paste-client-secret-here
