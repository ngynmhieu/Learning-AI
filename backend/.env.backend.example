# Points at the CLI-managed local Supabase stack (`supabase start`) — used
# for both local dev and deployment; there is no separate cloud config.
#
# Get ANON_KEY / SERVICE_ROLE_KEY by running `supabase status` after
# `supabase start`. These CAN change across a `supabase stop`/`start` cycle
# (observed firsthand) — if auth/storage calls start failing after
# restarting Supabase, re-sync these from `supabase status` first, along
# with the matching VITE_SUPABASE_ANON_KEY in frontend/.env.
#
# HOST, PORT, DEBUG, MANGA_BUCKET are omitted — they already match the code's
# own defaults (backend/app/core/config.py), so declaring them here is a no-op.

MODEL_NAME=qwen3.5-9b
MODELS_SERVICE_API_KEY=

# 127.0.0.1 (loopback) — correct for a bare host process (run_backend.bat).
# docker-compose.yml overrides these to host.docker.internal for the
# container case, since a bare process reaching its own LAN IP can get
# blocked by Windows Firewall on a Public-profile network; loopback never
# hits that filtering at all.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=paste-local-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=paste-local-service-role-key-here
