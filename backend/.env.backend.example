# Models service — the standalone model server this backend calls over HTTP.
# MODEL_NAME is the model *id* from the models service catalog (not an HF repo).
MODELS_SERVICE_URL=http://localhost:8001/v1
MODEL_NAME=qwen3.5-9b
MODELS_SERVICE_API_KEY=

# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database (Supabase Postgres — session pooler, async driver)
# Get the string from Supabase dashboard > Connect > Session pooler (port 5432).
# Change the scheme from postgresql:// to postgresql+asyncpg:// for SQLAlchemy async.
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:YOUR_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase Auth (used to verify JWTs server-side via supabase.auth.get_user)
# Find both under Supabase dashboard > Project Settings > API.
# The anon key is safe to use server-side for token verification.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase Storage (read module — scrape-import bytes flow through the backend).
# SUPABASE_SERVICE_ROLE_KEY bypasses Storage RLS: SECRET, server-only, never sent
# to the frontend. Find it under Supabase dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MANGA_BUCKET=manga
